# ============================================================================
# Environment Variables - Health Colombia ODS 3 ETL Pipeline
# Compatible with Docker and Podman (Rootless mode)
# ============================================================================

# --- PostgreSQL Data Warehouse Configuration ---
POSTGRES_DB=salud_colombia
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=etl_password_2026
POSTGRES_PORT=5432

# Local Connection String (host-level)
DB_URL=postgresql://etl_user:etl_password_2026@localhost:5432/salud_colombia

# --- PostgREST Configuration (REST API for Power BI) ---
POSTGREST_PORT=3000
PGRST_DB_SCHEMA=public
PGRST_DB_ANON_ROLE=etl_user

# --- Apache Superset Configuration ---
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=salud-colombia-ods3-secret-key-2026-secure
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@saludcolombia.gov.co
SUPERSET_IMAGE_NAME=docker.io/apache/superset:6.1.0

# --- Apache Airflow Configuration ---
AIRFLOW_IMAGE_NAME=docker.io/apache/airflow:3.1.8
AIRFLOW_WEBSERVER_PORT=8080
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
# In rootless podman, UID 0 maps to the invoking host user
AIRFLOW_UID=0

# --- External API Colombia Base URL ---
API_COLOMBIA_BASE_URL=https://api-colombia.com/api/v1