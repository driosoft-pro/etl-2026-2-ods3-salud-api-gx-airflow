erDiagram
    %% ==========================================
    %% CONFORMED DIMENSIONS
    %% ==========================================
    dim_time {
        serial sk_time PK
        integer year
        integer month
        varchar month_name
        integer quarter
        integer semester
        varchar periodo_codigo
        date full_date
        bigint batch_id
    }

    dim_geografia {
        serial sk_geografia PK
        varchar codigo_dane_municipio UK
        varchar municipio
        varchar codigo_dane_depto
        varchar departamento
        varchar region
        varchar capital
        numeric surface
        bigint population
        integer municipalities_count
        varchar phone_prefix
        varchar region_api
        bigint batch_id
    }

    %% ==========================================
    %% SPECIFIC DIMENSIONS
    %% ==========================================
    dim_regime {
        serial sk_regime PK
        varchar code UK
        varchar description
        bigint batch_id
    }

    dim_facility {
        serial sk_facility PK
        varchar provider_code
        varchar name
        varchar nit
        varchar nature
        integer care_level
        varchar manager
        varchar address
        varchar email
        varchar phone
        integer sk_geografia FK
        bigint batch_id
    }

    dim_capacity_type {
        serial sk_capacity_type PK
        varchar group
        varchar description
        bigint batch_id
    }

    %% Relación dimensional jerárquica
    dim_geografia ||--o{ dim_facility : "ubica"

    %% ==========================================
    %% FACT TABLES
    %% ==========================================
    fact_affiliates {
        serial sk_affiliate PK
        integer sk_time FK
        integer sk_geografia FK
        integer sk_regime FK
        bigint numero_afiliados
        bigint batch_id
    }

    fact_facility_capacity {
        serial sk_capacity PK
        integer sk_time FK
        integer sk_facility FK
        integer sk_capacity_type FK
        integer sk_geografia FK
        integer capacity_amount
        bigint batch_id
    }

    %% ==========================================
    %% FACT - DIMENSION RELATIONSHIPS
    %% ==========================================
    dim_time ||--o{ fact_affiliates : "sk_time"
    dim_geografia ||--o{ fact_affiliates : "sk_geografia"
    dim_regime ||--o{ fact_affiliates : "sk_regime"

    dim_time ||--o{ fact_facility_capacity : "sk_time"
    dim_facility ||--o{ fact_facility_capacity : "sk_facility"
    dim_capacity_type ||--o{ fact_facility_capacity : "sk_capacity_type"
    dim_geografia ||--o{ fact_facility_capacity : "sk_geografia"